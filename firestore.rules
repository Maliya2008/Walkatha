rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'merlinfiverr0@gmail.com' ||
        request.auth.token.email == 'mchethiyabandara@gmail.com'
      );
    }

    function hasAdminRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return isSuperAdmin() || hasAdminRole();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        isSuperAdmin() ||
        request.resource.data.role != 'admin' ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.resource.data.title is string && request.resource.data.title.size() > 0);
      allow delete: if isAdmin() || resource != null;
    }

    match /story_contents/{storyId} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.resource.data.fullContent is string && request.resource.data.fullContent.size() > 0);
      allow delete: if isAdmin() || resource != null;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.resource.data.title is string && request.resource.data.title.size() > 0);
      allow delete: if isAdmin() || resource != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.resource.data.name is string && request.resource.data.name.size() > 0);
      allow delete: if isAdmin() || resource != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || resource != null;
    }

    match /advertisements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /advertisement_settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /storyAdvertisements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
