rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Master admin verification via verified email
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'mchethiyabandara@gmail.com';
    }

    // Helper: Check if user document has admin role
    function hasAdminRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Full admin check
    function isAdmin() {
      return isSuperAdmin() || hasAdminRole();
    }

    // Helper: Check if a story or post is published (or default true if field omitted)
    function isPublished() {
      return !('published' in resource.data) || resource.data.published == true;
    }

    // 1. Users collection (Admin / Staff Profiles)
    match /users/{userId} {
      // Users can read their own profile; admins can read all profiles
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Users can create their own profile; privilege escalation prevented
      allow create: if isSignedIn() && request.auth.uid == userId && (
        isSuperAdmin() ||
        request.resource.data.role != 'admin' ||
        isAdmin()
      );
      // Only admins can update or delete user accounts
      allow update, delete: if isAdmin();
    }

    // 2. Stories collection (Main story library)
    match /stories/{storyId} {
      // Public can read published stories; drafts require admin
      allow read: if isPublished() || isAdmin();
      // Only admins can create, update, or delete stories
      allow create, update, delete: if isAdmin();
    }

    // 3. Posts collection (Collection alias fallback for stories)
    match /posts/{postId} {
      allow read: if isPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 4. Categories collection
    match /categories/{categoryId} {
      // Public can read categories for taxonomy & browsing
      allow read: if true;
      // Only admins can create, edit, or delete categories
      allow create, update, delete: if isAdmin();
    }

    // 5. Settings collection (Global site configuration)
    match /settings/{docId} {
      // Public can read site branding, meta tags, and contacts
      allow read: if true;
      // Only admins can modify settings
      allow create, update, delete: if isAdmin();
    }

    // 6. Advertisements collection
    match /advertisements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 7. Global advertisement settings collection
    match /advertisement_settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 8. Story-specific advertisements
    match /storyAdvertisements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default safety net: Deny all unhandled collection operations
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
