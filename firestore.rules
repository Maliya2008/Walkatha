rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the user is authorized as an admin in Firestore
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mchethiyabandara@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // User management
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    // Stories collection
    match /stories/{storyId} {
      // Public visitors can read published stories; Admins can read all stories
      allow read: if resource.data.published == true || isAdmin();
      
      // Only admins can create or delete stories
      allow create, delete: if isAdmin();

      // Admins can update any field; Public unauthenticated visitors can only increment views atomically on published stories
      allow update: if isAdmin() || (
        resource.data.published == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        (request.resource.data.views is int || request.resource.data.views is number) &&
        (
          (!resource.data.keys().hasAny(['views']) && request.resource.data.views == 1) ||
          (resource.data.keys().hasAny(['views']) && request.resource.data.views == resource.data.views + 1)
        )
      );
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings collection
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Advertisements collection
    match /advertisements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Global advertisement settings collection
    match /advertisement_settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Story-specific advertisements
    match /storyAdvertisements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Fallback rule for safety
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

